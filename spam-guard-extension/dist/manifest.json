{
  "manifest_version": 3,
  "name": "SpamGuard for Gmail",
  "version": "1.0.0",
  "description": "Real-time multilingual (Bengali + English) spam detection for Gmail, powered by a fine-tuned XLM-RoBERTa ONNX model.",
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*", "http://localhost:4000/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content-script.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SpamGuard"
  },
  "options_page": "options.html"
}
